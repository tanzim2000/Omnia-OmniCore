// index.js
// OmniCore entry point.
// Port layout:
//   3000  = the built-in admin face — OmniCore's own settings UI
//   4000  = the control face, where OmniVision picks a face to display
//   4001+ = dashboard faces, auto-assigned by OmniCore

const { readFaces } = require("./core/face-store");
const { startFace } = require("./core/face-loader");
const startControlFace = require("./core/control-face");
const startAdminFace = require("./core/admin-face");
const resourceScheduler = require("./core/resource-scheduler");
const coreUpdateScheduler = require("./core/core-update-scheduler");

// Bring back every dashboard face that was previously created
const faces = readFaces();
for (const face of faces) {
	startFace(face);
}

// The control face is always running
startControlFace();

// So is the admin face — it's built in, not something the user creates
startAdminFace();

if (faces.length === 0) {
	console.log("No dashboard faces yet — open port 4000 to create one");
}

// Silently keeps installed modules and themes current — see
// core/resource-scheduler.js. Started last and delayed on its own, so it
// never competes with faces actually coming up for anyone watching a cold
// start.
resourceScheduler.start();

// Keeps OmniCore itself current — see core/core-update-scheduler.js.
// Delayed slightly later than resourceScheduler so the two never pull
// from GitHub in the same instant on a cold start.
coreUpdateScheduler.start();